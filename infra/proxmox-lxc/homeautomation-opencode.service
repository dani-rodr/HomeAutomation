[Unit]
Description=HomeAutomation OpenCode Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homeautomation
Group=homeautomation
Environment=HOME=/home/homeautomation
ExecStart=/usr/local/bin/homeautomation-opencode-start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
