{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "home-assistant": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "mcp-proxy",
        "--transport",
        "streamablehttp",
        "http://home-assistant-host:9583/private_REPLACE_ME"
      ],
      "enabled": true
    },
    "android": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "android-mcp"
      ],
      "environment": {
        "ANDROID_MCP_DEVICE": "device-host:port"
      },
      "enabled": true
    }
  }
}
